# Copy to .env and fill in. `just` loads .env for every recipe.

# The EAS project id defaults to the Herdhand project. Set it only to build under your own Expo
# account: `eas init` prints the id.
HERDHAND_EAS_PROJECT_ID=

# The Expo account or organization that owns the project. Leave empty for your personal account.
HERDHAND_EAS_OWNER=
